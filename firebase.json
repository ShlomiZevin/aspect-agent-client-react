{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/builder/mcp",
        "destination": "https://aspect-agent-server-1018338671074.europe-west1.run.app/builder/mcp",
        "type": 302
      }
    ],
    "rewrites": [
      {
        "source": "/intelligence/zolstock",
        "destination": "/intelligence/zolstock.html"
      },
      {
        "source": "/zolstock/intelligence",
        "destination": "/zolstock/intelligence.html"
      },
      {
        "source": "/aspect/zolstock-purchasing-he",
        "destination": "/aspect/zolstock-purchasing-he.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          },
          {
            "key": "Pragma",
            "value": "no-cache"
          },
          {
            "key": "Expires",
            "value": "0"
          }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=31536000"
          }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|gif|png|svg|ico|webp)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=31536000"
          }
        ]
      }
    ]
  }
}
