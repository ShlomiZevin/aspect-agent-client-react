{
  "name": "aspect-react-client",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "sync-types": "node scripts/sync-builder-types.cjs",
    "postinstall": "node scripts/sync-builder-types.cjs",
    "predev": "node scripts/sync-builder-types.cjs",
    "prebuild": "node scripts/sync-builder-types.cjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy": "npm run build && firebase deploy --only hosting",
    "deploy:aspect": "npm run sync-types && vite build --mode aspect && node scripts/inject-share-pages.cjs && firebase use default && firebase deploy --only hosting",
    "deploy:lybi-prod": "npm run sync-types && vite build --mode lybi-prod && firebase use lybi-prod && firebase deploy --only hosting",
    "deploy:freeda": "npm run sync-types && vite build --mode freeda && firebase use freeda && firebase deploy --only hosting"
  },
  "dependencies": {
    "html2canvas": "^1.4.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-image-crop": "^11.0.10",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.30.3",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^5.4.21"
  }
}
